@inherits Microsoft.AspNetCore.Components.ComponentBase
@* SVG icon set with no external dependency. Stroke of 2, rounded corners. *@

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false"
     style="flex-shrink:0;@Style">
    @switch (Name)
    {
        case "inbox":
            <path d="M22 12h-6l-2 3h-4l-2-3H2" />
            <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
            break;

        case "folder":
            <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
            break;

        case "compose":
            <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.4 2.6a1.9 1.9 0 0 1 2.7 2.7l-9 9-3.6.9.9-3.6z" />
            break;

        case "arrow-right":
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
            break;

        case "user":
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;

        case "book":
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20" />
            break;

        case "sliders":
            <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" />
            break;

        case "alert-triangle":
            <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
            break;

        case "trash":
            <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            break;

        case "refresh":
            <path d="M3 12a9 9 0 0 1 9-9 9.7 9.7 0 0 1 6.7 2.7L21 8" />
            <path d="M21 3v5h-5" />
            <path d="M21 12a9 9 0 0 1-9 9 9.7 9.7 0 0 1-6.7-2.7L3 16" />
            <path d="M8 16H3v5" />
            break;

        case "search":
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
            break;

        case "close":
            <path d="M18 6 6 18M6 6l12 12" />
            break;

        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "send":
            <path d="m22 2-7 20-4-9-9-4Z" />
            <path d="M22 2 11 13" />
            break;

        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="m16 17 5-5-5-5" />
            <path d="M21 12H9" />
            break;

        case "plus":
            <path d="M5 12h14M12 5v14" />
            break;

        case "help":
            <circle cx="12" cy="12" r="10" />
            <path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3" />
            <path d="M12 17h.01" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 6v6l4 2" />
            break;

        case "reply":
            <path d="M9 14 4 9l5-5" />
            <path d="M20 20v-7a4 4 0 0 0-4-4H4" />
            break;

        case "terminal":
            <path d="m4 17 6-6-6-6" />
            <path d="M12 19h8" />
            break;

        case "shield-alert":
            <path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z" />
            <path d="M12 8v4" />
            <path d="M12 16h.01" />
            break;

        case "info":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
            break;

        case "mail":
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-10 5L2 7" />
            break;

        case "message":
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            break;

        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;

        case "chart":
            <path d="M3 3v16a2 2 0 0 0 2 2h16" />
            <path d="M7 15v2M12 9v8M17 12v5" />
            break;

        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4" />
            break;

        case "moon":
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            break;

        case "contrast":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none" />
            break;

        case "layers":
            <path d="m12 2 9 5-9 5-9-5z" />
            <path d="m3 12 9 5 9-5" />
            <path d="m3 17 9 5 9-5" />
            break;

        default:
            <circle cx="12" cy="12" r="10" />
            break;
    }
</svg>

@code {
    /// <summary>Nom de l'icone a tracer.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>Taille en pixels, appliquee en largeur et en hauteur.</summary>
    [Parameter] public int Size { get; set; } = 16;

    /// <summary>Style additionnel place sur l'element svg.</summary>
    [Parameter] public string? Style { get; set; }
}
